.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 28rpx;
}

.icon {
  width: 112rpx;
  height: 112rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.cat {
  margin-top: 20rpx;
  font-size: 30rpx;
  color: var(--color-text-secondary);
}

.hero .amount-lg {
  margin-top: 12rpx;
}

.type-tag {
  margin-top: 16rpx;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(11, 61, 46, 0.08);
  color: var(--color-brand);
}

.info-panel {
  margin-top: 24rpx;
  padding: 8rpx 28rpx;
}

.row {
  min-height: 88rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid var(--color-border);
  font-size: 28rpx;
  color: var(--color-text);
}

.row:last-child {
  border-bottom: none;
}

.row text:first-child {
  color: var(--color-text-secondary);
}

.actions {
  margin-top: 40rpx;
}

.danger {
  color: var(--color-expense) !important;
  border-color: rgba(196, 92, 38, 0.35) !important;
  width: 100%;
}
