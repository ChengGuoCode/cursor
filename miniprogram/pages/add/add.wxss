.type-switch {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.type-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background: rgba(11, 61, 46, 0.06);
  color: var(--color-text-secondary);
  font-weight: 560;
}

.type-item.active.expense {
  background: rgba(196, 92, 38, 0.14);
  color: var(--color-expense);
}

.type-item.active.income {
  background: rgba(31, 107, 79, 0.14);
  color: var(--color-income);
}

.amount-panel {
  background: linear-gradient(160deg, #FFFFFF, #EEF4F0);
}

.amount-label {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.amount-row {
  margin-top: 8rpx;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.currency {
  font-size: 40rpx;
  color: var(--color-brand);
  font-weight: 650;
}

.amount-input {
  flex: 1;
  font-size: 72rpx;
  font-weight: 700;
  height: 90rpx;
  color: var(--color-text);
}

.category-grid {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18rpx 12rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 0;
  border-radius: var(--radius-md);
}

.category-item.active {
  background: rgba(11, 61, 46, 0.08);
}

.category-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.category-name {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.form-panel {
  margin-top: 28rpx;
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  color: var(--color-text-secondary);
  font-size: 26rpx;
}

.form-value {
  color: var(--color-text);
  font-size: 26rpx;
}

.remark-input {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  margin-left: 24rpx;
}

.keypad {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  padding: 20rpx;
}

.key {
  height: 88rpx;
  border-radius: var(--radius-md);
  background: rgba(11, 61, 46, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 560;
  color: var(--color-text);
}

.key:active {
  background: rgba(11, 61, 46, 0.12);
}

.submit-bar {
  margin-top: 28rpx;
  padding-bottom: 12rpx;
}

.submit-btn {
  width: 100%;
}
