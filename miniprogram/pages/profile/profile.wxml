<view class="page profile-page">
  <view class="profile-hero soft-panel">
    <view class="avatar">
      <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
      <text wx:else>{{avatarText}}</text>
    </view>
    <view class="profile-info">
      <view class="nickname">{{user.nickname || '未登录'}}</view>
      <view class="motto">{{user.motto || '登录后同步账单与群组'}}</view>
      <view class="phone" wx:if="{{user.phoneMask}}">{{user.phoneMask}}</view>
    </view>
  </view>

  <view class="section soft-panel menu-panel">
    <view class="menu-item" bindtap="onExport">
      <text>导出账单</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onBudget">
      <text>月度预算</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onCategories">
      <text>分类管理</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onAccounts">
      <text>账户管理</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="section soft-panel menu-panel">
    <view class="menu-item" bindtap="onAbout">
      <text>关于轻记账</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onToggleMock">
      <text>数据模式</text>
      <text class="menu-value">{{useMock ? '本地 Mock' : '真实接口'}}</text>
    </view>
  </view>

  <button
    class="btn-primary login-btn"
    loading="{{loggingIn}}"
    disabled="{{loggingIn}}"
    bindtap="onLoginOrLogout"
  >
    {{user.id ? '退出登录' : '微信登录'}}
  </button>
</view>
