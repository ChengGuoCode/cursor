<view class="page budget-page">
  <view class="hero soft-panel">
    <view class="hero-kicker">{{monthLabel}}</view>
    <view class="hero-title">{{heroTitle}}</view>
    <view class="hero-desc">{{heroDesc}}</view>
  </view>

  <view class="soft-panel amount-panel">
    <text class="field-label">预算金额（元）</text>
    <view class="amount-row">
      <text class="currency">¥</text>
      <input
        class="amount-input amount"
        type="digit"
        maxlength="10"
        placeholder="0"
        value="{{budgetInput}}"
        focus="{{inputFocus}}"
        bindinput="onBudgetInput"
      />
    </view>

    <view class="chip-row presets">
      <view
        class="chip {{budgetInput === item ? 'active' : ''}}"
        wx:for="{{presets}}"
        wx:key="*this"
        data-value="{{item}}"
        bindtap="onPreset"
      >{{item}}</view>
    </view>
  </view>

  <view class="soft-panel tip-panel">
    <view class="tip-title">小提示</view>
    <view class="tip-item">设为 0 表示不启用预算，概览页不再显示进度条</view>
    <view class="tip-item" wx:if="{{!isGroup}}">建议按可支配收入的 60%～80% 设定月支出上限</view>
    <view class="tip-item" wx:else>仅群主与管理员可修改本群月度预算</view>
  </view>

  <button
    class="btn-primary save-btn"
    loading="{{saving}}"
    disabled="{{saving}}"
    bindtap="onSave"
  >保存预算</button>
</view>
