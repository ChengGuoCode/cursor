.hero {
  background: linear-gradient(145deg, var(--cover, #0B3D2E), rgba(11, 61, 46, 0.85));
  color: #fff;
  border: none;
}

.name {
  font-size: 44rpx;
  font-weight: 700;
}

.meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

.balance-line {
  margin-top: 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
}

.hero .amount-income,
.hero .amount-expense {
  color: #fff;
}

.member {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
}

.member + .member {
  border-top: 1rpx solid var(--color-border);
}

.member-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: rgba(11, 61, 46, 0.1);
  color: var(--color-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

.member-main {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.member-name {
  font-size: 28rpx;
  font-weight: 560;
}

.member-role {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.suggest {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  font-size: 28rpx;
}

.suggest + .suggest {
  border-top: 1rpx solid var(--color-border);
}

.bill-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
}

.bill-row + .bill-row {
  border-top: 1rpx solid var(--color-border);
}

.bill-title {
  font-size: 28rpx;
  font-weight: 560;
}

.bill-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}
