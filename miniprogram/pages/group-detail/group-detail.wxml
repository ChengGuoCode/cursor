<view class="page detail-page" wx:if="{{group}}">
  <view class="soft-panel hero">
    <view class="name">{{group.groupName}}</view>
    <view class="meta">{{members.length}} 位成员</view>
    <view class="invite-row" wx:if="{{group.inviteCode}}">
      <text class="invite-label">邀请码</text>
      <text class="invite-code" bindtap="copyInvite">{{group.inviteCode}}</text>
      <text class="invite-copy" bindtap="copyInvite">复制</text>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">成员</text>
      <text class="section-action" bindtap="onEditMyName">改我的昵称</text>
    </view>
    <view class="soft-panel member-list">
      <view
        class="member"
        wx:for="{{members}}"
        wx:key="groupMemberId"
        data-index="{{index}}"
        bindtap="onMemberAction"
      >
        <view class="member-avatar">{{item.avatarText}}</view>
        <view class="member-main">
          <text class="member-name">{{item.memberName || '未命名'}}</text>
          <text class="member-role">{{item.roleLabel}}</text>
        </view>
        <text wx:if="{{isOwner}}" class="member-more">⋮</text>
      </view>
      <view wx:if="{{!members.length}}" class="empty-wrap">暂无成员</view>
    </view>
  </view>

  <view class="section" wx:if="{{canManage}}">
    <view class="section-head">
      <text class="section-title">管理</text>
    </view>
    <view class="soft-panel action-list">
      <view class="action-row" bindtap="goApplyList">
        <text>入群申请</text>
        <text class="action-arrow">›</text>
      </view>
      <view class="action-row" wx:if="{{isOwner}}" bindtap="onRename">
        <text>修改群名称</text>
        <text class="action-arrow">›</text>
      </view>
      <view class="action-row" wx:if="{{isOwner}}" bindtap="onRefreshInvite">
        <text>刷新邀请码</text>
        <text class="action-arrow">›</text>
      </view>
      <view class="action-row danger" wx:if="{{isOwner}}" bindtap="onDissolve">
        <text>解散群组</text>
        <text class="action-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="footer-actions" wx:if="{{!isOwner}}">
    <button class="btn-ghost exit-btn" bindtap="onExit">退出群组</button>
  </view>
</view>

<view class="page" wx:elif="{{loading}}">
  <view class="empty-wrap">加载中…</view>
</view>

<view class="page" wx:else>
  <view class="empty-wrap soft-panel">暂无当前群组信息</view>
</view>
