<view class="page groups-page">
  <view class="head">
    <view>
      <view class="page-title">群组</view>
      <view class="page-subtitle">合租、出游、聚餐一起记账</view>
    </view>
    <view class="head-actions">
      <view class="btn-ghost mini" bindtap="openApply">申请加入</view>
      <view class="btn-primary mini" bindtap="openCreate">新建</view>
    </view>
  </view>

  <view class="link-row" wx:if="{{!guestMode}}" bindtap="goApplyList">
    <text>入群申请</text>
    <text class="link-arrow">查看 ›</text>
  </view>

  <block wx:if="{{groups.length}}">
    <view
      class="group-card {{item.isCurrent ? 'is-current' : ''}}"
      wx:for="{{groups}}"
      wx:key="groupId"
      data-id="{{item.groupId}}"
      bindtap="goDetail"
    >
      <view class="group-body">
        <view class="group-top">
          <text class="group-name">{{item.groupName}}</text>
          <view class="tag-row">
            <text wx:if="{{item.isCurrent}}" class="group-tag current">当前</text>
            <text wx:if="{{item.roleLabel}}" class="group-tag">{{item.roleLabel}}</text>
          </view>
        </view>
        <view class="group-meta">
          {{item.memberCount || 0}} 人
          <text wx:if="{{item.inviteCode}}"> · 邀请码 {{item.inviteCode}}</text>
        </view>
      </view>
    </view>
  </block>

  <view wx:elif="{{guestMode}}" class="empty-wrap soft-panel">
    <view>登录后可查看群组</view>
    <view class="page-subtitle">浏览无需登录；新建或申请时会引导登录</view>
  </view>

  <view wx:else class="empty-wrap soft-panel">
    <view>还没有群组</view>
    <view class="page-subtitle">创建一个，或用邀请码申请加入</view>
    <button class="btn-primary empty-btn" bindtap="openCreate">新建群组</button>
  </view>
</view>
