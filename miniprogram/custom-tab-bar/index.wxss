.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(16px);
  box-shadow: 0 -8rpx 32rpx rgba(11, 61, 46, 0.06);
  border-top: 1rpx solid rgba(11, 61, 46, 0.06);
}

.tabbar-inner {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 110rpx;
  padding: 0 8rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding-bottom: 12rpx;
  color: #7A8B82;
  position: relative;
}

.tab-item.active {
  color: #0B3D2E;
}

.label {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1;
}

.icon-wrap {
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 简易几何图标，避免依赖外部图片资源 */
.icon {
  width: 36rpx;
  height: 36rpx;
  position: relative;
  opacity: 0.7;
}

.icon.on {
  opacity: 1;
}

.icon-home {
  border: 4rpx solid currentColor;
  border-radius: 8rpx 8rpx 4rpx 4rpx;
  height: 28rpx;
  margin-top: 8rpx;
}

.icon-home::before {
  content: '';
  position: absolute;
  left: 50%;
  top: -14rpx;
  width: 28rpx;
  height: 28rpx;
  border-left: 4rpx solid currentColor;
  border-top: 4rpx solid currentColor;
  transform: translateX(-50%) rotate(45deg);
  border-radius: 4rpx;
}

.icon-list {
  border-left: 4rpx solid currentColor;
  border-right: 4rpx solid currentColor;
  border-radius: 4rpx;
  width: 30rpx;
}

.icon-list::before,
.icon-list::after {
  content: '';
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  height: 4rpx;
  background: currentColor;
  border-radius: 4rpx;
}

.icon-list::before { top: 8rpx; }
.icon-list::after { top: 18rpx; box-shadow: 0 10rpx 0 currentColor; }

.icon-group {
  width: 40rpx;
  height: 28rpx;
  border: 4rpx solid currentColor;
  border-radius: 20rpx;
  margin-top: 10rpx;
}

.icon-group::before {
  content: '';
  position: absolute;
  left: 50%;
  top: -14rpx;
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
  transform: translateX(-50%);
  background: #fff;
}

.icon-user {
  width: 22rpx;
  height: 22rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
  margin-top: 2rpx;
}

.icon-user::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -16rpx;
  width: 34rpx;
  height: 16rpx;
  border: 4rpx solid currentColor;
  border-bottom: none;
  border-radius: 34rpx 34rpx 0 0;
  transform: translateX(-50%);
}

.tab-item.center {
  justify-content: flex-end;
}

.center-btn {
  width: 96rpx;
  height: 96rpx;
  margin-top: -46rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #1F6B4F, #0B3D2E);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(11, 61, 46, 0.28);
}

.center-btn.active {
  transform: scale(1.04);
}

.center-plus {
  font-size: 56rpx;
  line-height: 1;
  margin-top: -4rpx;
  font-weight: 300;
}

.safe {
  height: env(safe-area-inset-bottom);
  background: transparent;
}
